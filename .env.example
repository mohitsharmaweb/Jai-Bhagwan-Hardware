# Environment configuration for Jai Bhagwan Hardware & Sanitary

# BACKEND CONFIGURATION
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# SUPABASE CREDENTIALS
# Obtain these from your Supabase project dashboard -> Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# DEFAULT BUSINESS
DEFAULT_BUSINESS_ID=00000000-0000-0000-0000-000000000001

# WHATSAPP BUSINESS CLOUD API (Optional for automated delivery)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
